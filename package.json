{
  "name": "portfolio-plage-nuxt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio « plage » (Nuxt, Neon, Cloudinary, Three.js) avec back-office sécurisé.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "start:local": "node --env-file=.env .output/server/index.mjs",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "admin:reset-2fa": "tsx --env-file-if-exists=.env scripts/reset-2fa.ts",
    "icons:generate": "node scripts/generate-icon-library.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "db:purge:demo": "tsx --env-file-if-exists=.env scripts/purge-demo.ts",
    "db:purge:messages": "tsx --env-file-if-exists=.env scripts/purge-messages.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "check:env": "tsx --env-file-if-exists=.env scripts/check-env.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.1.7",
    "nuxt": "^4.6.2",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "unpdf": "^2.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "simple-icons": "^16.36.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
