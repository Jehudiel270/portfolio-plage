# =============================================================================
#  Portfolio « plage » — variables d'environnement
#  Copiez ce fichier en `.env` (jamais commité) puis renseignez les valeurs.
#  Windows PowerShell : Copy-Item .env.example .env      macOS/Linux : cp .env.example .env
# =============================================================================

# --- Base de données Neon -----------------------------------------------------
# Neon > Dashboard > votre projet > « Connect » > chaîne « Pooled connection ».
# Format : postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Session d'administration -------------------------------------------------
# Secret d'au moins 32 caractères. Génération : openssl rand -base64 48
# Sert à signer les jetons de session et le jeton anti-CSRF.
NUXT_SESSION_PASSWORD=

# --- Cloudinary (images) ------------------------------------------------------
# Cloudinary > Console > « Programmable Media » > « API Keys ».
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET : ne doit JAMAIS être préfixé NUXT_PUBLIC_ ni exposé au navigateur.
CLOUDINARY_API_SECRET=

# --- E-mail (SMTP via Nodemailer) --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (TLS implicite), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché, ex. "Portfolio <no-reply@votre-domaine.com>"
SMTP_FROM=

# --- Site ---------------------------------------------------------------------
# URL publique (balises Open Graph, liens absolus)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Création du premier administrateur (scripts uniquement) ------------------
# Utilisés par `pnpm admin:create`. Laissez-les commentés dans les fichiers versionnés.
# ADMIN_EMAIL=vous@exemple.com
# ADMIN_PASSWORD=un-mot-de-passe-long-et-unique
